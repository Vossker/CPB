CPB_ENVIRONMENT=development
CPB_DATABASE_URL=postgresql+psycopg://cpb:cpb-dev-only@postgres:5432/cpb
CPB_API_SECRET=replace-with-a-long-random-secret
CPB_STORAGE_ENDPOINT=http://minio:9000
CPB_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
CPB_STORAGE_ACCESS_KEY=cpb-minio
CPB_STORAGE_SECRET_KEY=replace-with-a-random-secret
CPB_STORAGE_BUCKET=cpb
CPB_STORAGE_REGION=us-east-1
CPB_SIGNUP_BONUS=100
CPB_PLATFORM_USERNAME=__platform__
CPB_MAX_CPU=4
CPB_MAX_MEMORY_MB=4096
CPB_MAX_TIMEOUT_SECONDS=900
CPB_MAX_BUNDLE_BYTES=52428800
CPB_MAX_ARTIFACT_BYTES=104857600
CPB_MAX_RETRIES=2
CPB_LEASE_SECONDS=120
CPB_NODE_OFFLINE_SECONDS=90
CPB_WORKER_POLL_SECONDS=5
CPB_WORKER_HEARTBEAT_SECONDS=20
CPB_WORKER_LOG_UPLOAD_SECONDS=30

